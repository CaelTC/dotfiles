#!/usr/bin/env bash
# cca — launch a HUMAN's interactive `claude` behind a per-Session capture Proxy.
#
# The human+force-bypass caller of the shared capture lifecycle: it tags the
# Session's Origin as Human and forces `--permission-mode bypassPermissions` (evolved
# from the `claude --permission-mode auto` alias). Its sibling is `ccagent`
# (Origin=Agent, args passed straight through). Both source the same
# lib/cca-capture.sh so the capture lifecycle lives in one place.
#
# Install: build the binary (`cargo build --release`) and put both `claude-dash`
# and this script on PATH, e.g.
#   ln -s "$PWD/target/release/claude-dash" ~/.local/bin/claude-dash
#   ln -s "$PWD/bin/cca"                     ~/.local/bin/cca
# Then launch Claude Code with `cca` in place of `claude` (alias claude=cca if you
# like). cca finds `claude-dash` via $CLAUDE_DASH_BIN or PATH.

set -u

_cca_prog=cca
_cca_origin=human
_cca_perm=force-bypass
set -- --rc "$@"
# Resolve this script's real directory through symlinks (portable: no readlink -f).
_cca_src="${BASH_SOURCE[0]}"
while [ -L "$_cca_src" ]; do
  _cca_dir="$(cd -P "$(dirname "$_cca_src")" && pwd)"
  _cca_src="$(readlink "$_cca_src")"
  [[ "$_cca_src" != /* ]] && _cca_src="$_cca_dir/$_cca_src"
done
_cca_dir="$(cd -P "$(dirname "$_cca_src")" && pwd)"
source "$_cca_dir/lib/cca-capture.sh"
