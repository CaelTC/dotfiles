#!/usr/bin/env bash
# ccagent — launch an AGENT's `claude` behind a per-Session capture Proxy.
#
# The agent-session sibling of `cca`: same capture lifecycle, two differences —
# it tags the Session's Origin as Agent, and it passes the caller's args straight
# through WITHOUT forcing `--permission-mode auto`, so a background agent can run
# unattended (e.g. `ccagent --dangerously-skip-permissions -p "…"`). Routing agent
# sessions through capture keeps the account-wide Budget (Utilization %) fresh.
# Both `ccagent` and `cca` source the same lib/cca-capture.sh.
#
# Install: symlink alongside `cca`, e.g.
#   ln -s "$PWD/bin/ccagent" ~/.local/bin/ccagent
# ccagent finds `claude-dash` via $CLAUDE_DASH_BIN or PATH.

set -u

_cca_prog=ccagent
_cca_origin=agent
_cca_perm=passthrough
# Resolve this script's real directory through symlinks (portable: no readlink -f).
_cca_src="${BASH_SOURCE[0]}"
while [ -L "$_cca_src" ]; do
  _cca_dir="$(cd -P "$(dirname "$_cca_src")" && pwd)"
  _cca_src="$(readlink "$_cca_src")"
  [[ "$_cca_src" != /* ]] && _cca_src="$_cca_dir/$_cca_src"
done
_cca_dir="$(cd -P "$(dirname "$_cca_src")" && pwd)"
source "$_cca_dir/lib/cca-capture.sh"
